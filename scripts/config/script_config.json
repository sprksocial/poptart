{
  "lexiconsPath": "lexicons",
  "packagesPath": "packages",
  "binPath": "scripts",
  "packageMappings": {
    "poptart": "packages/poptart",
    "poptart_bluesky_text": "packages/poptart_bluesky_text",
    "poptart_cli": "packages/poptart_cli",
    "poptart_core": "packages/poptart_core",
    "poptart_did_plc": "packages/poptart_did_plc",
    "poptart_lex_gen": "packages/poptart_lex_gen",
    "poptart_lexicon": "packages/poptart_lexicon",
    "poptart_multiformats": "packages/poptart_multiformats",
    "poptart_oauth": "packages/poptart_oauth",
    "poptart_primitives": "packages/poptart_primitives",
    "poptart_test": "packages/poptart_test",
    "poptart_xrpc": "packages/poptart_xrpc"
  },
  "networkConfig": {
    "maxRetries": 3,
    "initialDelayMs": 1000,
    "backoffMultiplier": 2.0,
    "timeoutMs": 30000,
    "maxConcurrentConnections": 10
  },
  "loggingConfig": {
    "level": "info",
    "includeTimestamp": true,
    "includeLocation": false
  },
  "maxParallelOperations": 4,
  "enableCaching": true,
  "cacheDirectory": ".dart_tool/scripts_cache"
}
